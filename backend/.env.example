# Backend Server Configuration
PORT=4000

# Frontend CORS Configuration
FRONTEND_URL=http://localhost:3000

# Hyperledger Firefly Configuration
FIREFLY_WS_URL=ws://127.0.0.1:5000/ws
FIREFLY_HTTP_URL=http://127.0.0.1:5000
FIREFLY_NAMESPACE=default
FIREFLY_RECONNECT_INTERVAL=5000
FIREFLY_MAX_RECONNECT_ATTEMPTS=10

